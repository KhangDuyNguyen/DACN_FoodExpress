# Chi can khi deploy; dev dung Vite proxy nen khong can dat.
# VITE_API_URL=https://api.example.com/api

# Copy vao web/.env.local va dien Tilemap key cong khai cho ban do theo doi don.
# Gioi han referrer/domain cua web trong VIETMAP Console, gom localhost neu dung dev.
# Cac bien VITE_ co the doc tu trinh duyet. Khong dat Services key o day.
VITE_VIETMAP_TILEMAP_KEY=your_tilemap_key
